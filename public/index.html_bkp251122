        <path d="M1440 0 L1190 330" /><path d="M1440 0 L1320 490" /><path d="M1440 0 L1440 610" />
        <path d="M1440 0 L1055 45" /><path d="M1440 0 L1065 145" /><path d="M1440 0 L1140 270" />
        <path d="M1440 0 L1255 410" /><path d="M1440 0 L1380 540" />
      </g>
      <g fill="none" stroke="url(#webSilk)" stroke-linecap="round">
        <path d="M1365 0 C1378 42 1406 76 1440 91" stroke-width="1.4" opacity=".72" />
        <path d="M1295 0 C1319 75 1365 132 1440 164" stroke-width="1.35" opacity=".66" />
        <path d="M1215 0 C1251 109 1323 187 1440 232" stroke-width="1.3" opacity=".62" />
        <path d="M1130 0 C1183 145 1283 242 1440 304" stroke-width="1.3" opacity=".58" />
        <path d="M1050 0 C1117 178 1244 292 1440 374" stroke-width="1.25" opacity=".54" />
        <path d="M985 0 C1064 212 1208 340 1440 445" stroke-width="1.2" opacity=".5" />
      </g>
      <g transform="translate(1135 260)" fill="none" stroke="url(#spiderMetal)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M-13 -10 L-35 -31 L-59 -39 L-82 -61" /><path d="M-20 -5 L-49 -12 L-74 -9 L-101 -23" />
        <path d="M-20 6 L-49 14 L-73 30 L-99 51" /><path d="M-13 12 L-34 34 L-51 56 L-73 78" />
        <path d="M13 -10 L35 -31 L59 -39 L82 -61" /><path d="M20 -5 L49 -12 L74 -9 L101 -23" />
        <path d="M20 6 L49 14 L73 30 L99 51" /><path d="M13 12 L34 34 L51 56 L73 78" />
      </g>
      <g transform="translate(1135 260)" fill="#9fb4ca" stroke="#d4deea" stroke-width="1.2">
        <circle cx="-35" cy="-31" r="3.2" /><circle cx="-49" cy="-12" r="3.2" />
        <circle cx="-49" cy="14" r="3.2" /><circle cx="-34" cy="34" r="3.2" />
        <circle cx="35" cy="-31" r="3.2" /><circle cx="49" cy="-12" r="3.2" />
        <circle cx="49" cy="14" r="3.2" /><circle cx="34" cy="34" r="3.2" />
      </g>
      <g transform="translate(1135 260)">
        <ellipse cx="0" cy="4" rx="18" ry="25" fill="#19283a" opacity=".65" />
        <ellipse cx="0" cy="3" rx="15" ry="22" fill="url(#spiderBody)" stroke="#a9bbcf" stroke-width="1.5" />
        <ellipse cx="0" cy="-26" rx="10" ry="11" fill="url(#spiderBody)" stroke="#d0dce8" stroke-width="1.4" />
        <g fill="#dbe8f5"><circle cx="-4" cy="-27" r="1.5" /><circle cx="4" cy="-27" r="1.5" /></g>
      </g>
    </svg>
  </div>

  <header class="page topbar">
    <div class="brand">
      <div class="brand-mark" aria-label="NShieldOps logo">
        <svg viewBox="0 0 240 240" role="img" aria-hidden="true">
          <defs>
            <linearGradient id="shieldFill" x1="0%" x2="100%" y1="0%" y2="100%">
              <stop offset="0%" stop-color="#e6eefb" /><stop offset="25%" stop-color="#dfe7f8" /><stop offset="100%" stop-color="#8da3d6" />
            </linearGradient>
            <linearGradient id="ringBlue" x1="0%" x2="100%" y1="0%" y2="0%">
              <stop offset="0%" stop-color="#34d7ff" /><stop offset="50%" stop-color="#4aa8ff" /><stop offset="100%" stop-color="#2a6dff" />
            </linearGradient>
          </defs>
          <path d="M120 20 L194 42 L194 115 C194 165 162 205 120 222 C78 205 46 165 46 115 L46 42 Z" fill="url(#shieldFill)" stroke="rgba(255,255,255,.75)" stroke-width="5" />
          <text x="120" y="154" text-anchor="middle" font-size="108" font-weight="800" font-family="Segoe UI, Arial, sans-serif" fill="#f5f9ff" letter-spacing="-8">N</text>
          <path d="M30 158 C65 120 108 122 138 152 C168 182 211 182 225 146" fill="none" stroke="url(#ringBlue)" stroke-width="16" stroke-linecap="round" />
          <path d="M164 116 C187 121 201 134 204 162 C208 193 190 216 161 225" fill="none" stroke="url(#ringBlue)" stroke-width="16" stroke-linecap="round" />
        </svg>
      </div>
      <div>
        <div class="brand-title">NShieldOps</div>
        <div class="brand-sub">Security Operations</div>
      </div>
    </div>
    <div id="userActions" class="hidden">
      <span id="userLabel" class="muted"></span>
      <button id="logoutBtn" class="btn" type="button">Log out</button>
    </div>
  </header>

  <main class="page">
    <section id="authView" class="auth-wrap">
      <div class="panel">
        <h1 id="authTitle">Welcome back</h1>
        <p id="authSubtitle" class="subtitle">Sign in to manage your projects.</p>
        <form id="authForm">
          <div id="nameField" class="field hidden">
            <label for="name">Your name</label>
            <input id="name" autocomplete="name" />
          </div>
          <div class="field">
            <label for="email">Work email</label>
            <input id="email" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="password">Password</label>
            <input id="password" type="password" minlength="12" maxlength="128" autocomplete="current-password" required />
          </div>
          <p id="authError" class="form-error" role="alert"></p>
          <button id="authSubmit" class="btn primary full" type="submit">Sign in</button>
        </form>
        <p class="muted" style="margin:20px 0 0">
          <span id="authSwitchText">New to NShieldOps?</span>
          <button id="authSwitch" class="text-btn" type="button">Create an account</button>
        </p>
      </div>
    </section>

    <section id="projectsView" class="hidden">
      <div class="permissions-row">
        <div>
          <h1>Your projects</h1>
          <p id="userRoleText" class="subtitle">Projects assigned to you</p>
        </div>
        <div style="display: flex; gap: 10px;">
          <button id="cleanupBtn" class="btn danger" type="button">Wipe All Data</button>
          <div id="adminControls">
            <button id="newProjectBtn" class="btn primary" type="button">＋ Create project</button>
          </div>
        </div>
      </div>

      <div class="panel" style="margin-bottom: 24px; padding: 20px;">
        <h3>User Management</h3>
        <p class="muted" style="margin-bottom: 12px;">Registered users in the system.</p>
        <div id="usersList" style="display: flex; gap: 10px; flex-wrap: wrap;"></div>
      </div>

      <div id="projectsGrid" class="projects-grid"></div>
      <div id="emptyProjects" class="empty hidden">
        <h2>No projects assigned</h2>
      </div>
    </section>

    <section id="createView" class="auth-wrap hidden">
      <button class="text-btn back-link" type="button" data-go-projects>← Back to projects</button>
      <div class="panel">
        <h1>Create a project</h1>
        <p class="subtitle">Create a project to organize your assets.</p>
        <form id="projectForm">
          <div class="field">
            <label for="projectName">Project name</label>
            <input id="projectName" placeholder="e.g. Business Unit" required maxlength="80" />
          </div>
          <div class="field">
            <label for="projectType">Project type</label>
            <select id="projectType">
              <option value="Security operations">Security operations</option>
              <option value="Household">Household</option>
              <option value="Business">Business</option>
            </select>
          </div>
          <div class="field">
            <label for="projectUser">Assign to User</label>
            <select id="projectUser" required></select>
          </div>
          <p id="projectError" class="form-error" role="alert"></p>
          <button class="btn primary full" type="submit">Create project</button>
        </form>
      </div>
    </section>

    <section id="dashboardView" class="hidden">
      <button class="text-btn back-link" type="button" data-go-projects>← All projects</button>
      <div class="dashboard-head">
        <div>
          <h1 id="dashboardProjectName">Project dashboard</h1>
          <p id="dashboardProjectMeta" class="subtitle"></p>
        </div>
        <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
          <div id="addAssetControl" class="hidden">
            <button id="addAssetBtn" class="btn primary" type="button">＋ Add asset</button>
          </div>
          <span class="badge">Monitoring active</span>
        </div>
      </div>

      <div class="stats">
        <article class="panel stat">
          <span class="stat-label">Open incidents</span>
          <strong id="statIncidents" class="stat-value">0</strong>
        </article>
        <article class="panel stat">
          <span class="stat-label">High-priority alerts</span>
          <strong id="statAlerts" class="stat-value">0</strong>
        </article>
        <article class="panel stat">
          <span class="stat-label">Registered assets</span>
          <strong id="assetCountValue" class="stat-value">0</strong>
        </article>
        <article class="panel stat">
          <span class="stat-label">Security health</span>
          <strong id="statHealth" class="stat-value">100%</strong>
        </article>
      </div>

      <div class="dashboard-columns">
        <section class="panel">
          <h2>Priority alerts</h2>
          <div id="alertsList"><div class="muted">Loading alerts...</div></div>
        </section>
        <section class="panel">
          <h2>Assets in project</h2>
          <div id="assetsList" class="asset-list"></div>
        </section>
      </div>
    </section>
  </main>

  <div id="assetModal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="assetModalTitle">
    <div class="modal-panel">
      <div class="modal-head">
        <h2 id="assetModalTitle">Add asset</h2>
        <button id="closeAssetModal" class="close-btn" type="button" aria-label="Close">×</button>
      </div>
      <div class="asset-option" style="margin-bottom:14px;">
        <div class="asset-option-copy">
          <div class="asset-option-title">Enroll current laptop</div>
          <div class="asset-option-subtitle">Generate a link to connect your Python agent.</div>
        </div>
        <button id="enrollLaptopBtn" class="btn primary asset-btn" type="button">Continue</button>
      </div>
      <div id="assetFormContainer" class="hidden" style="margin-top:18px;"></div>
    </div>
  </div>

  <script>
    const API_BASE = "";
    const $ = id => document.getElementById(id);
    const views = ["authView", "projectsView", "createView", "dashboardView"];

    let currentUser = null;
    let currentProjectId = "";
    let isSignupMode = false;

    function showView(viewId) {
      views.forEach(id => $(id).classList.toggle("hidden", id !== viewId));
      if (viewId !== "dashboardView" && window.dashboardTimer) clearInterval(window.dashboardTimer);
    }

    async function api(path, options = {}) {
      const res = await fetch(`${API_BASE}${path}`, {
        headers: { "Content-Type": "application/json", ...options.headers },
        ...options
      });
      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        throw new Error(err.error || "Request failed");
      }
      return res.status === 204 ? null : res.json();
    }

    // --- Auth ---
    function updateUserStatus() {
      if (!currentUser) return $("userActions").classList.add("hidden");
      $("userLabel").textContent = `${currentUser.name} (${currentUser.email})`;
      $("userActions").classList.remove("hidden");
      $("adminControls").classList.remove("hidden");
      $("addAssetControl").classList.remove("hidden");
    }

    async function loadSession() {
      try {
        const data = await api("/api/auth/me");
        currentUser = data.user;
        updateUserStatus();
        renderProjects();
        renderUsers();
        showView("projectsView");
      } catch {
        showView("authView");
      }
    }

    $("authSwitch").addEventListener("click", () => {
      isSignupMode = !isSignupMode;
      $("authTitle").textContent = isSignupMode ? "Create an account" : "Welcome back";
      $("nameField").classList.toggle("hidden", !isSignupMode);
      $("authSubmit").textContent = isSignupMode ? "Create account" : "Sign in";
      $("authSwitchText").textContent = isSignupMode ? "Already have an account?" : "New to NShieldOps?";
      $("authSwitch").textContent = isSignupMode ? "Sign in" : "Create an account";
    });

    $("authForm").addEventListener("submit", async e => {
      e.preventDefault();
      $("authError").textContent = "";
      try {
        const payload = { email: $("email").value.trim(), password: $("password").value };
        if (isSignupMode) payload.name = $("name").value.trim();
        
        const endpoint = isSignupMode ? "/api/auth/signup" : "/api/auth/login";
        const data = await api(endpoint, { method: "POST", body: JSON.stringify(payload) });
        
        currentUser = data.user;
        $("authForm").reset();
        updateUserStatus();
        renderProjects();
        renderUsers();
        showView("projectsView");
      } catch (err) {
        $("authError").textContent = err.message;
      }
    });

    $("logoutBtn").addEventListener("click", async () => {
      await api("/api/auth/logout", { method: "POST" });
      window.location.reload();
    });

    // --- User Management ---
    async function renderUsers() {
      const list = $("usersList");
      try {
        const users = await api("/api/users");
        $("projectUser").innerHTML = users.map(u => `<option value="${u.id}">${u.name} (${u.email})</option>`).join("");

        list.innerHTML = users.map(u => `
          <div class="asset-card" style="flex: 1; min-width: 250px;">
            <div>
              <strong>${u.name}</strong>
              <div class="muted" style="font-size:12px">${u.email}</div>
            </div>
            ${u.id !== currentUser.id ? `<button class="btn danger" onclick="deleteUser('${u.id}')">Delete</button>` : '<span class="badge">You</span>'}
          </div>
        `).join("");
      } catch (err) {
        list.innerHTML = `<div class="form-error">${err.message}</div>`;
      }
    }

    async function deleteUser(id) {
      if (!confirm("WARNING: Deleting this user will also delete all their projects and assets. Proceed?")) return;
      try {
        await api(`/api/users/${id}`, { method: "DELETE" });
        renderUsers();
        renderProjects();
      } catch (err) {
        alert(err.message);
      }
    }

    // --- Projects ---
    async function renderProjects() {
      const grid = $("projectsGrid");
      try {
        const projects = await api("/api/projects");
        $("emptyProjects").classList.toggle("hidden", projects.length > 0);
        
        grid.innerHTML = projects.map(p => `
          <article class="project-card">
            <h2>${p.name}</h2>
            <p>${p.type || "Security operations"}</p>
            <div class="assigned-list" style="margin-bottom: 12px;">
              Assigned to: <strong>${p.assigned_name}</strong>
            </div>
            <div class="project-meta">
              <span class="badge">Active</span>
              <button class="btn" onclick="openDashboard('${p.id}', '${p.name}')">Open</button>
            </div>
          </article>
        `).join("");
      } catch (err) {
        grid.innerHTML = `<div class="form-error">${err.message}</div>`;
      }
    }

    $("newProjectBtn").addEventListener("click", () => showView("createView"));
    document.querySelectorAll("[data-go-projects]").forEach(btn => {
      btn.addEventListener("click", () => { showView("projectsView"); renderProjects(); });
    });

    $("projectForm").addEventListener("submit", async e => {
      e.preventDefault();
      try {
        await api("/api/projects", {
          method: "POST",
          body: JSON.stringify({
            name: $("projectName").value.trim(),
            type: $("projectType").value,
            assigned_user_id: $("projectUser").value
          })
        });
        $("projectForm").reset();
        renderProjects();
        showView("projectsView");
      } catch (err) {
        $("projectError").textContent = err.message;
      }
    });

    // --- Dashboard & Assets ---
    function openDashboard(id, name) {
      currentProjectId = id;
      $("dashboardProjectName").textContent = name;
      showView("dashboardView");
      loadDashboardData(); 
      if (window.dashboardTimer) clearInterval(window.dashboardTimer);
      window.dashboardTimer = setInterval(loadDashboardData, 5000);
    }

    async function loadDashboardData() {
      try {
        const assets = await api("/api/dashboard/assets");
        $("assetCountValue").textContent = assets.length;
        let onlineCount = 0;

        $("assetsList").innerHTML = assets.map(a => {
          if (a.online) onlineCount++;
          const metrics = a.online ? `CPU: ${a.cpu || 0}% · RAM: ${a.mem || 0}%` : `Awaiting heartbeat...`;
          
          return `
            <div class="asset-card">
              <div>
                <strong>${a.name}</strong>
                <div class="muted" style="font-size:12px">${a.os || 'Unknown'} · ${metrics}</div>
              </div>
              <div style="display:flex; align-items:center; gap:12px;">
                <span class="device-pill ${a.online ? 'online' : 'pending'}">
                  ${a.online ? 'Online' : 'Offline'}
                </span>
                <button class="btn danger" onclick="deleteAsset('${a.asset_id}')">Remove</button>
              </div>
            </div>
          `;
        }).join("") || "<div class='empty'><h3>No assets yet</h3><p>Add your laptop to this project.</p></div>";

        $("statHealth").textContent = `${assets.length === 0 ? 100 : Math.round((onlineCount / assets.length) * 100)}%`;

        const events = await api("/api/dashboard/events");
        $("alertsList").innerHTML = events.map(e => `
          <div class="alert">
            <div>
              <strong>${e.type.replace(/_/g, ' ').toUpperCase()}</strong>
              <div class="muted">${e.asset_name} · ${new Date(e.ts).toLocaleTimeString()}</div>
              <div class="muted" style="font-size:11px">${e.detail}</div>
            </div>
            <span class="severity ${e.severity}">${e.severity.toUpperCase()}</span>
          </div>
        `).join("") || "<div class='muted'>System is healthy.</div>";

        $("statAlerts").textContent = events.filter(e => e.severity === "high").length;
        $("statIncidents").textContent = events.length;

      } catch (err) {
        console.error(err);
      }
    }

    async function deleteAsset(id) {
      if (!confirm("Remove this asset? The agent will lose access immediately.")) return;
      try {
        await api(`/api/assets/${id}`, { method: "DELETE" });
        loadDashboardData();
      } catch (err) {
        alert(err.message);
      }
    }

    // --- Danger Zone ---
    $("cleanupBtn").addEventListener("click", async () => {
      if (!confirm("WARNING: This will delete ALL your projects and assets. Proceed?")) return;
      if (!confirm("Are you absolutely sure?")) return;

      try {
        await api("/api/dashboard/cleanup", { method: "POST" });
        renderProjects();
      } catch (err) {
        alert(err.message);
      }
    });

    // --- Enrollment ---
    $("addAssetBtn").addEventListener("click", () => $("assetModal").classList.remove("hidden"));
    $("closeAssetModal").addEventListener("click", () => $("assetModal").classList.add("hidden"));

    $("enrollLaptopBtn").addEventListener("click", () => {
      $("assetFormContainer").classList.remove("hidden");
      $("assetFormContainer").innerHTML = `
        <h3>Register Laptop</h3>
        <div class="field"><label>Laptop name</label><input id="laptopName" value="My Laptop" /></div>
        <button id="genEnrollLink" class="btn primary full" type="button">Generate Link</button>
        <div id="enrollResult" style="margin-top:16px;"></div>
      `;

      $("genEnrollLink").addEventListener("click", async () => {
        const btn = $("genEnrollLink");
        btn.disabled = true; btn.textContent = "Generating...";
        try {
          const data = await api("/api/enroll/sessions", {
            method: "POST",
            body: JSON.stringify({ name: $("laptopName").value.trim() || "My Laptop", project_id: currentProjectId })
          });
          $("enrollResult").innerHTML = `
            <div class="field"><label>Enrollment command</label><input readonly value="${data.command}" onclick="this.select()" /></div>
            <div id="enrollWait" class="muted">⏳ Waiting for connection...</div>
          `;
          pollUntilEnrolled(data.asset_id);
        } catch (error) {
          $("enrollResult").innerHTML = `<p class="form-error">${error.message}</p>`;
        } finally {
          btn.disabled = false; btn.textContent = "Generate Link";
        }
      });
    });

    async function pollUntilEnrolled(assetId) {
      const start = Date.now();
      while (Date.now() - start < 600000) {
        try {
          const assets = await api("/api/dashboard/assets");
          if (assets.find(a => a.asset_id === assetId)?.online) {
            $("enrollWait").innerHTML = `✅ <b>Agent connected!</b>`;
            $("enrollWait").style.color = "#34d399";
            setTimeout(() => { $("assetModal").classList.add("hidden"); loadDashboardData(); }, 1500);
            return;
          }
        } catch {}
        await new Promise(r => setTimeout(r, 3000));
      }
    }

    loadSession();
  </script>
</body>
</html>