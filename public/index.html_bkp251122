<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0b1220" />
  <title>NShieldOps</title>

  <style>
    :root {
      color-scheme: dark;
      --bg: #0b1220;
      --panel: #111b2d;
      --line: rgba(148, 163, 184, .17);
      --text: #e5eefb;
      --muted: #94a3b8;
      --blue: #60a5fa;
      --green: #34d399;
      --amber: #fbbf24;
      --red: #f87171;
      --shadow: 0 16px 38px rgba(2, 6, 23, .28);
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      min-height: 100%;
      font-family: Inter, system-ui, -apple-system, "Segoe UI", sans-serif;
      background: #0b1220;
      color: var(--text);
    }

    body { min-height: 100vh; position: relative; isolation: isolate; }
    button, input, select, textarea { font: inherit; }
    button { cursor: pointer; }
    .hidden { display: none !important; }
    .page { width: min(1160px, calc(100% - 32px)); margin: 0 auto; }

    .ambient-art {
      position: fixed; inset: 0; z-index: -1; pointer-events: none;
      opacity: .13; overflow: hidden;
      background: radial-gradient(circle at 12% 0, rgba(42, 87, 143, .25), transparent 40%), #0b1220;
    }
    .ambient-art svg { width: 100%; height: 100%; display: block; }

    .topbar {
      display: flex; justify-content: space-between; align-items: center;
      gap: 16px; padding: 18px 0; border-bottom: 1px solid var(--line); position: relative; z-index: 1;
    }

    .brand { display: flex; align-items: center; gap: 11px; font-weight: 750; }
    .brand-mark { width: 42px; height: 42px; flex: 0 0 42px; }
    .brand-mark svg { width: 100%; height: 100%; display: block; }
    .brand-title { font-weight: 800; letter-spacing: -.02em; }
    .brand-sub { color: var(--muted); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }

    main { padding: 34px 0 64px; position: relative; z-index: 1; }
    h1 { margin: 0 0 8px; font-size: clamp(1.7rem, 3vw, 2.3rem); }
    h2 { margin: 0 0 10px; }
    h3 { margin: 0 0 8px; }
    .muted, .subtitle { color: var(--muted); }
    .subtitle { margin: 0 0 24px; line-height: 1.55; }

    .panel, .project-card, .asset-card {
      background: rgba(17, 27, 45, .94);
      border: 1px solid var(--line);
      border-radius: 18px;
      box-shadow: var(--shadow);
    }

    .auth-wrap { width: min(440px, 100%); margin: 5vh auto; }
    .auth-wrap .panel { padding: 28px; }

    .field { margin: 17px 0; }
    label { display: block; margin-bottom: 7px; font-weight: 650; }
    input, select, textarea {
      width: 100%; padding: 12px 13px; color: var(--text);
      background: #0b1220; border: 1px solid var(--line); border-radius: 10px;
    }
    input:focus, select:focus, textarea:focus { outline: 2px solid rgba(96, 165, 250, .55); outline-offset: 1px; }

    .btn {
      padding: 10px 14px; border: 1px solid var(--line); border-radius: 10px;
      color: var(--text); background: #17243a; transition: filter .2s ease;
    }
    .btn:hover { filter: brightness(1.08); }
    .btn.primary { color: white; border: 0; background: #3269b8; }
    .btn.full { width: 100%; padding: 13px; font-weight: 700; }
    .btn.danger { color: #fecaca; background: rgba(127, 29, 29, .35); border-color: rgba(248, 113, 113, .35); }
    .btn.danger:hover { background: rgba(127, 29, 29, .6); }

    .text-btn { border: 0; background: none; color: var(--blue); padding: 0; font-weight: 700; }
    .form-error { min-height: 22px; color: var(--red); }
    
    .projects-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
    .project-card { padding: 20px; }
    .project-card h2 { font-size: 1.15rem; margin-bottom: 6px; }
    .project-card p { color: var(--muted); margin: 6px 0 18px; }
    .project-meta { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
    .assigned-list { margin: 10px 0 0; font-size: 12px; color: var(--muted); line-height: 1.5; }

    .badge {
      display: inline-block; padding: 4px 9px; border-radius: 999px;
      color: var(--green); background: rgba(52, 211, 153, .12); font-size: 12px; font-weight: 700;
    }

    .empty { padding: 28px; text-align: center; border: 1px dashed var(--line); border-radius: 16px; color: var(--muted); margin-top: 16px; }
    .back-link { margin-bottom: 18px; }
    .dashboard-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; }

    .stats { display: grid; grid-template-columns: repeat(4, minmax(150px, 1fr)); gap: 14px; margin: 22px 0; }
    .stat { padding: 18px; }
    .stat-label { color: var(--muted); font-size: 13px; }
    .stat-value { display: block; margin-top: 8px; font-size: 1.8rem; font-weight: 800; }

    .dashboard-columns { display: grid; grid-template-columns: 1.3fr 1fr; gap: 16px; margin-top: 16px; }
    .dashboard-columns > .panel { padding: 20px; }

    .alert { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--line); }
    .alert:last-child { border-bottom: 0; }
    .severity { font-size: 12px; font-weight: 750; }
    .severity.high { color: var(--red); }
    .severity.medium { color: var(--amber); }
    .severity.low { color: var(--green); }

    .asset-list { display: grid; gap: 12px; margin-top: 12px; }
    .asset-card { padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; box-shadow: none; }

    .device-pill { padding: 5px 9px; border-radius: 999px; font-size: 12px; font-weight: 700; color: var(--blue); background: rgba(96, 165, 250, .12); border: 1px solid rgba(96, 165, 250, .25); white-space: nowrap; }
    .device-pill.pending { color: var(--amber); background: rgba(251, 191, 36, .12); border-color: rgba(251, 191, 36, .2); }
    .device-pill.online { color: var(--green); background: rgba(52, 211, 153, .12); border-color: rgba(52, 211, 153, .2); }

    .modal { position: fixed; inset: 0; z-index: 10; background: rgba(2, 6, 23, .76); display: grid; place-items: center; padding: 20px; }
    .modal-panel { width: min(760px, 100%); max-height: min(90vh, 900px); overflow-y: auto; background: #111b2d; border: 1px solid var(--line); border-radius: 24px; box-shadow: var(--shadow); padding: 24px 20px 20px; }
    .modal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
    .modal-head h2 { margin: 0; font-size: 1.8rem; }
    .close-btn { border: 0; background: transparent; color: var(--muted); font-size: 2rem; line-height: 1; padding: 0 6px; }

    .prototype-note { color: var(--muted); font-size: .85rem; line-height: 1.5; padding: 12px; border: 1px solid var(--line); border-radius: 12px; margin: 16px 0; }
    .permissions-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin: 12px 0 18px; }

    @media (max-width: 760px) {
      .stats { grid-template-columns: repeat(2, 1fr); }
      .dashboard-columns { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="ambient-art" aria-hidden="true">
    <svg viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
      <defs>
        <linearGradient id="spiderMetal" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#dce8f5" />
          <stop offset=".32" stop-color="#859bb5" />
          <stop offset=".68" stop-color="#425a76" />
          <stop offset="1" stop-color="#c5d3e2" />
        </linearGradient>
        <linearGradient id="webSilk" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#a9c9ed" />
          <stop offset=".5" stop-color="#607f9f" />
          <stop offset="1" stop-color="#38536f" />
        </linearGradient>
        <radialGradient id="spiderBody" cx=".35" cy=".25" r=".85">
          <stop offset="0" stop-color="#d2dfec" />
          <stop offset=".35" stop-color="#7e94ae" />
          <stop offset="1" stop-color="#26384e" />
        </radialGradient>
      </defs>
      <g fill="none" stroke="url(#webSilk)" stroke-width="1.15" opacity=".8">
